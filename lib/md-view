#!/bin/sh
# md-view: show a Markdown file as a web page (macOS first).
#
#   md-view [options] <file.md>
#     --out <page.html>   write the page there
#     --no-open           make the page, do not open it
#     --width 60|70|80|90 start width of the text column, in percent
#     --theme light|dark|auto
#     --palette github|tokyo
#     --browser auto|firefox|chrome|safari|<absolute path>
#     --no-cache          build the page again
#     --tree on|off       show the file tree of the root folder, or one file
#     --list-tree         print the root and the tree files, write no page
#   md-view --init-config
#   md-view --print-association
#   md-view --version
#
# Writes one page (the Markdown text and marked inline; mermaid from a pinned
# CDN script with an SRI hash) and opens it with the system opener. The page
# goes to ${XDG_CACHE_HOME:-$HOME/.cache}/md-view/<base>-<crc>.html unless --out
# names another file, and is used again while no input changed. If that folder
# cannot be used, the page goes to ${TMPDIR:-/tmp}/md-view-<pid>.html.
# marked.min.js is read from this script's folder, or from MARKED_JS. The GitHub
# CSS and the highlight.js files are read from this script's folder too.
#
# Defaults come from ${XDG_CONFIG_HOME:-$HOME/.config}/md-view/config.ini,
# section [View], keys width, theme, palette, browser, tree, root, tree_depth
# and tree_max_files. A flag beats the file. No value
# from the file or a flag is run as code; it is used only when it equals an
# accepted word, or (browser only) when it is an absolute path to a program.

LC_ALL=C
export LC_ALL
# The one version string. The --version flag, the page key, and the page
# meta read it.
version=0.1.0

self_dir=$(cd "$(dirname -- "$0")" && pwd) || exit 2
ini=${XDG_CONFIG_HOME:-$HOME/.config}/md-view/config.ini
cr=$(printf '\r')
nl='
'
# The umask of the caller. The cache page is made under 077; the browser gets this one.
old_umask=$(umask)

usage() {
    echo 'usage: md-view [--out <page.html>] [--no-open] [--width 60|70|80|90]' >&2
    echo '               [--theme light|dark|auto] [--palette github|tokyo]' >&2
    echo '               [--browser B] [--no-cache]' >&2
    echo '               [--tree on|off] [--list-tree] <file.md>' >&2
    echo '       md-view --init-config' >&2
    echo '       md-view --print-association' >&2
    echo '       md-view --version' >&2
    exit 2
}

# trim TEXT: sets trimmed to TEXT without the spaces and tabs at both ends.
trim() {
    trimmed=$1
    trimmed=${trimmed#"${trimmed%%[! 	]*}"}
    trimmed=${trimmed%"${trimmed##*[! 	]}"}
}

# palette_ok WORD: true if WORD is an accepted palette word, github or tokyo.
# The test is exact and case-sensitive.
palette_ok() {
    case $1 in
        github|tokyo) return 0 ;;
        *) return 1 ;;
    esac
}

# browser_ok VALUE: true if VALUE is an accepted browser= value. An absolute
# path must name an executable file, or on macOS a folder that ends in ".app".
browser_ok() {
    case $1 in
        auto|firefox|chrome|safari)
            return 0 ;;
        /*.app|/*.app/)
            [ "$(uname -s)" = Darwin ] && [ -d "$1" ] && return 0
            [ -f "$1" ] && [ -x "$1" ] ;;
        /*)
            [ -f "$1" ] && [ -x "$1" ] ;;
        *)
            return 1 ;;
    esac
}

# num_val VALUE CEILING: sets num to VALUE, or to CEILING when VALUE is larger.
# VALUE must be a decimal number of 1 or more; else num is empty and the return
# is 1. A long number is not given to the shell arithmetic, so it cannot overflow.
num_val() {
    num=
    case $1 in
        ''|*[!0-9]*) return 1 ;;
    esac
    v=$1
    while :; do
        case $v in
            0?*) v=${v#0} ;;
            *) break ;;
        esac
    done
    [ "$v" = 0 ] && return 1
    if [ "${#v}" -gt 5 ] || [ "$v" -gt "$2" ]; then
        num=$2
    else
        num=$v
    fi
}

# read_ini: reads config.ini, section [View]. Sets cfg_width, cfg_theme,
# cfg_palette, cfg_browser, cfg_tree, cfg_root, cfg_depth and cfg_max to the last
# valid value of each key; sets cfg_browser_bad=1 if a browser= line has a value
# that is not accepted. Other values are ignored.
read_ini() {
    cfg_width=
    cfg_theme=
    cfg_palette=
    cfg_browser=
    cfg_browser_bad=0
    cfg_tree=
    cfg_root=
    cfg_depth=
    cfg_max=
    [ -f "$ini" ] && [ -r "$ini" ] || return 0
    section=
    while IFS= read -r line || [ -n "$line" ]; do
        line=${line%"$cr"}
        trim "$line"
        line=$trimmed
        case $line in
            ''|'#'*|';'*)
                continue ;;
            '['*)
                section=$line
                continue ;;
            *=*) ;;
            *)
                continue ;;
        esac
        [ "$section" = '[View]' ] || continue
        trim "${line%%=*}"
        key=$trimmed
        trim "${line#*=}"
        val=$trimmed
        case $key in
            width)
                case $val in
                    60|70|80|90) cfg_width=$val ;;
                esac ;;
            theme)
                case $val in
                    light|dark|auto) cfg_theme=$val ;;
                esac ;;
            palette)
                palette_ok "$val" && cfg_palette=$val ;;
            browser)
                if browser_ok "$val"; then
                    cfg_browser=$val
                else
                    cfg_browser_bad=1
                fi ;;
            tree)
                case $val in
                    on|off) cfg_tree=$val ;;
                esac ;;
            root)
                case $val in
                    dir|repo) cfg_root=$val ;;
                esac ;;
            tree_depth)
                num_val "$val" 12 && cfg_depth=$num ;;
            tree_max_files)
                num_val "$val" 2000 && cfg_max=$num ;;
        esac
    done < "$ini"
}

# browsers_found: the browser words that this system has.
browsers_found() {
    found=
    if command -v firefox >/dev/null 2>&1 || [ -d /Applications/Firefox.app ]; then
        found="$found firefox"
    fi
    if command -v google-chrome >/dev/null 2>&1 || command -v chromium >/dev/null 2>&1 \
        || [ -d '/Applications/Google Chrome.app' ]; then
        found="$found chrome"
    fi
    if [ -d /Applications/Safari.app ]; then
        found="$found safari"
    fi
    printf '%s\n' "${found# }"
}

# init_config: writes a commented sample config.ini if there is no file. It
# never replaces a file, a link or anything else at that path.
init_config() {
    if [ -e "$ini" ] || [ -L "$ini" ]; then
        echo "md-view: $ini exists, not changed"
        exit 0
    fi
    mkdir -p "$(dirname -- "$ini")" || { echo "md-view: cannot make the folder of $ini" >&2; exit 1; }
    list=$(browsers_found)
    # noclobber: the shell refuses to replace a file made since the test above.
    set -C
    cat > "$ini" <<EOF || { echo "md-view: cannot write $ini" >&2; exit 1; }
# Defaults for md-view.
# A flag on the command line beats a value here. A line that starts with
# "#" or ";" is a comment. A value that is not accepted is ignored.
#
# width: start width of the text column, in percent: 60, 70, 80 or 90.
# theme: light, dark or auto (auto follows the system).
# palette: github or tokyo. tokyo has a day and a night version, and the theme picks one.
# browser: auto, firefox, chrome, safari, or an absolute path to a program.
# Browsers found on this system: ${list:-none}
# tree: on shows the files under the root in one page, with a file tree on
# the left; off shows one file, as a page without the tree.
# root: dir takes the folder of the opened file; repo takes the nearest
# folder upward with .git, else the folder of the file.
# tree_depth: 1 to 12 (default 6). tree_max_files: 1 to 2000 (default 500).
# A number over the ceiling gives the ceiling.

[View]
width=70
theme=auto
palette=github
browser=auto
tree=on
root=dir
tree_depth=6
tree_max_files=500
EOF
    set +C
    echo "$ini"
    exit 0
}

# print_association: prints the File associations entry. Its command is the
# absolute path of the launcher, then !.!. The path is command -v md-view when that
# is absolute; else the first file that exists of the installed launcher, the
# checkout launcher and this script. A fallback path is resolved, with no "..".
print_association() {
    exe=$(command -v md-view 2>/dev/null)
    case $exe in
        /*) ;;
        *)
            for exe in "$self_dir/../../bin/md-view" "$self_dir/../bin/md-view" "$self_dir/md-view"; do
                [ -f "$exe" ] && break
            done
            exe=$(cd "$(dirname -- "$exe")" && pwd)/md-view ;;
    esac
    # The file manager escapes the file name in !.! before the shell reads the
    # command, so !.! stays unquoted. The path is quoted only when the shell needs it.
    case $exe in
        *[!A-Za-z0-9_./+:@%,=-]*)
            q=$(printf '%s' "$exe" | sed -e 's/["$`\\]/\\&/g')
            cmd="\"$q\" !.!" ;;
        *)
            cmd="$exe !.!" ;;
    esac
    cat <<EOF
far2l file association for Markdown (add it once):

  Mask:                              *.md
  View command (used for Alt+F3):    $cmd

far2l already escapes the file name in !.!, so the command does not quote it.
Run md-view --print-association from the copy that far2l must use.

Steps in far2l:
  1. Press F9, open the Commands menu and choose File associations.
  2. Press Ins to add an entry.
  3. In "A file mask or several file masks", type: *.md
  4. Tick "View command (used for Alt+F3)" and type: $cmd
  5. Press OK. Alt+F3 on a .md file now opens it in the browser.

Defaults file (md-view --init-config writes a commented sample):
  $ini
  [View]
  width=60|70|80|90       (default 70)
  theme=light|dark|auto   (default auto)
  browser=auto|firefox|chrome|safari|<absolute path to a program>
Flags for one run: --width N, --theme T, --browser B, --no-cache.
EOF
}

# open_page PAGE: opens PAGE with the browser in $browser. Each command runs
# with exec in a subshell, with PAGE as one argument, so the exit status shows.
open_page() {
    b=$browser
    if [ "$(uname -s)" = Darwin ]; then
        case $b in
            firefox) app=Firefox ;;
            chrome) app='Google Chrome' ;;
            safari) app=Safari ;;
            /*.app|/*.app/) [ -d "$b" ] && app=$b || app= ;;
            *) app= ;;
        esac
        if [ -n "$app" ]; then
            ( exec open -a "$app" "$1" ) || { echo 'md-view: open failed' >&2; exit 1; }
            return 0
        fi
    else
        case $b in
            firefox)
                command -v firefox >/dev/null 2>&1 && b=firefox || b=auto ;;
            chrome)
                if command -v google-chrome >/dev/null 2>&1; then
                    b=google-chrome
                elif command -v chromium >/dev/null 2>&1; then
                    b=chromium
                else
                    b=auto
                fi ;;
            safari)
                b=auto ;;
        esac
        case $b in
            auto|/*) ;;
            *)
                ( exec "$b" "$1" ) || { echo "md-view: $b failed" >&2; exit 1; }
                return 0 ;;
        esac
    fi
    case $b in
        /*)
            ( exec "$b" "$1" ) || { echo 'md-view: the browser failed' >&2; exit 1; }
            return 0 ;;
    esac
    # auto: a single-word $BROWSER, then open, then xdg-open.
    if [ -n "${BROWSER:-}" ]; then
        case $BROWSER in
            -*|*[!A-Za-z0-9_./+-]*)
                echo 'md-view: BROWSER is not a single command name, ignored' >&2 ;;
            *)
                if command -v "$BROWSER" >/dev/null 2>&1; then
                    ( exec "$BROWSER" "$1" ) || { echo 'md-view: $BROWSER failed' >&2; exit 1; }
                    return 0
                fi ;;
        esac
    fi
    if command -v open >/dev/null 2>&1; then
        ( exec open "$1" ) || { echo 'md-view: open failed' >&2; exit 1; }
    elif command -v xdg-open >/dev/null 2>&1; then
        ( exec xdg-open "$1" ) || { echo 'md-view: xdg-open failed' >&2; exit 1; }
    else
        echo "$1"
    fi
}

# real_of DIR: sets rp to the real path of DIR (cd -P, then pwd -P). The "x"
# after pwd keeps a newline at the end of the path, which command substitution
# would remove. DIR must be absolute or start with "./". Returns 1 on failure.
real_of() {
    rp=$(cd -P "$1" && pwd -P && echo x) || return 1
    rp=${rp%"$nl"x}
}

# find_repo_root START: sets repo_root to the first folder from START upward
# that has .git (a folder or a file). START is a real path. The walk checks
# $HOME (its real path, in home_real) and stops there; it never checks /.
# Returns 1 when no folder matches.
find_repo_root() {
    repo_root=
    d=$1
    while [ "$d" != / ]; do
        if [ -e "$d/.git" ]; then
            repo_root=$d
            return 0
        fi
        [ -n "$home_real" ] && [ "$d" = "$home_real" ] && break
        real_of "$d/.." || break
        d=$rp
    done
    return 1
}

# The awk function enc(s): s with each byte outside A-Za-z0-9._~/- written as
# %XX, two upper-case hex digits. Only A-Za-z0-9._~/%- come out.
enc_fn='
BEGIN {
    for (i = 1; i < 256; i++) ord[sprintf("%c", i)] = i
    hex = "0123456789ABCDEF"
    safe = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._~/-"
}
function enc(s,    r, i, c, n) {
    r = ""
    for (i = 1; i <= length(s); i++) {
        c = substr(s, i, 1)
        if (index(safe, c) > 0) {
            r = r c
        } else {
            n = ord[c]
            r = r "%" substr(hex, int(n / 16) + 1, 1) substr(hex, n % 16 + 1, 1)
        }
    }
    return r
}
'

# enc_path TEXT: prints TEXT encoded. A newline in TEXT becomes %0A. The added
# newline ends the last record, so a newline at the end of TEXT is kept too.
enc_path() {
    printf '%s\n' "$1" | awk "$enc_fn"'
        { s = s (NR > 1 ? "%0A" : "") enc($0) }
        END { print s }'
}

# scan_find [PRIMARY...]: lists the tree files under the root as ./<tree path>,
# one per line. It runs in the root, so a pattern character in the root path
# cannot change a pattern. It skips .git, node_modules and hidden folders,
# hidden files, a name with a byte below 0x20 and a path deeper than
# tree_depth. find does not follow a symlink, and -type f skips a symlink.
# The PRIMARY arguments go before the -print that scan_find adds at the end, so a
# caller can add a branch with its own -print (tree_newer does). The status is
# find's: 1 when find cannot read a folder, or when an -exec command fails.
scan_find() {
    deep='./*'
    i=0
    while [ "$i" -lt "$tree_depth" ]; do
        deep=$deep/*
        i=$((i + 1))
    done
    ctl=$(printf '*[\001-\037]*')
    (
        cd "$tree_root" || exit 1
        # scan-rule
        find . \( -name "$ctl" -o -type d \( -name '.?*' -o -name node_modules \) \) -prune -o -path "$deep" -prune -o -type f ! -name '.*' \( -name '*.[mM][dD]' -o -name '*.[mM][aA][rR][kK][dD][oO][wW][nN]' \) "$@" -print 2>/dev/null
    )
}

# scan_tree: scans the root in one walk. The walk gives each tree file as a
# ./<tree path> line and wc -c gives its size. Sets tree_list to the
# "<state> <tree path>" lines in tree order, up to the cap (state is page, big or
# cut), tree_count to their number, tree_capped to 1 when more files exist, and
# opened_in_list to 1 when the opened file is one of the lines. The opened file
# is always "page"; when it is not in tree_list, list_tree_text adds it after the
# list. Its bytes count first toward the page limit. A file that wc cannot read
# counts 0 bytes. The walk status is not checked: find gives 1 when wc cannot read
# a file, and when it cannot read a folder. The walk is used in both cases.
scan_tree() {
    [ -d "$tree_root" ] || return 1
    walk=$(scan_find -exec wc -c {} +)
    # The opened file joins the scan unless its tree path has a byte below 0x20.
    ctlb=$(printf '\001-\037')
    case $tree_opened in
        *[$ctlb]*) extra= ;;
        *) extra=./$tree_opened ;;
    esac
    # The path lines of the walk and the opened file, sorted into tree order.
    sorted=$(
        { printf '%s\n' "$walk"; [ -n "$extra" ] && printf '%s\n' "$extra"; } |
        awk '/^\.\// && !seen[$0]++ { p = substr($0, 3); n = split(p, a, "/"); print n " " p }' |
        LC_ALL=C sort -k1,1n -k2
    ) || return 1
    res=$(
        cd "$tree_root" || exit 1
        opened_size=$(wc -c 2>/dev/null < "./$tree_opened")
        # The walk, a blank line, then the sorted paths.
        { printf '%s\n' "$walk"; echo; [ -n "$sorted" ] && printf '%s\n' "$sorted"; } |
        MD_OPENED=$tree_opened MD_OPENED_SIZE=$opened_size MD_MAX=$tree_max awk '
        BEGIN {
            limit = 8388608
            big_limit = 1048576
            opened = ENVIRON["MD_OPENED"]
            total = ENVIRON["MD_OPENED_SIZE"] + 0
            max = ENVIRON["MD_MAX"] + 0
            phase = 0
            count = 0
            capped = 0
            inlist = 0
        }
        # Phase 0 reads the walk. A wc line is "<bytes> ./<path>", with blanks
        # in front. Path lines start with "./". A "total" line is skipped.
        phase == 0 {
            if ($0 == "") phase = 1
            else if ($0 ~ /^[ 0-9]/) {
                sub(/^ +/, "")
                i = index($0, " ")
                if (substr($0, i + 1, 2) == "./") bytes[substr($0, i + 1)] = substr($0, 1, i - 1) + 0
            }
            next
        }
        $0 == "" { next }
        {
            p = substr($0, index($0, " ") + 1)
            if (count >= max) { capped = 1; next }
            count++
            if (p == opened) {
                state = "page"
                inlist = 1
            } else {
                n = (("./" p) in bytes) ? bytes["./" p] : 0
                if (n > big_limit) state = "big"
                else if (total + n > limit) state = "cut"
                else { total += n; state = "page" }
            }
            print state " " p
        }
        END { print "#meta " count " " capped " " inlist }'
    ) || return 1
    meta=${res##*"$nl"}
    case $res in
        *"$nl"*) tree_list=${res%"$nl"*} ;;
        *) tree_list= ;;
    esac
    meta=${meta#\#meta }
    tree_count=${meta%% *}
    meta=${meta#* }
    tree_capped=${meta%% *}
    opened_in_list=${meta#* }
}

# list_tree_text: the --list-tree output. Line 1 is the root, encoded. In
# one-file mode line 2 is "off". Else one "<state> <ENC>" line per tree file,
# the opened file after them when it is not in the list, and "cap <N>" last
# when the cap stopped the scan.
list_tree_text() {
    enc_path "$tree_root"
    if [ "$tree_mode" != 1 ]; then
        echo off
        return 0
    fi
    if [ -n "$tree_list" ]; then
        printf '%s\n' "$tree_list" | awk "$enc_fn"'
            { i = index($0, " "); print substr($0, 1, i - 1) " " enc(substr($0, i + 1)) }'
    fi
    if [ "$opened_in_list" != 1 ]; then
        printf 'page %s\n' "$(enc_path "$tree_opened")"
    fi
    if [ "$tree_capped" = 1 ]; then
        printf 'cap %s\n' "$tree_count"
    fi
}

# page_files: prints the file elements of a tree page. The opened file goes first
# in the script element "md", then each other "page" file of tree_list in a
# script element of the class "md-file". Each has data-path, the encoded tree
# path. Then the tree index "md-tree" has the "<state> <ENC>" lines of
# list_tree_text, without the root line and the cap line. One awk pass reads
# all files from the root, as "./<tree path>", and removes a BOM on line 1 and
# a CR at a line end. One sed pass then gives the text the escapes of the
# one-file page: "\" becomes "\\", "</" becomes "<\/" and "<!--" becomes "<\!--".
# A file that cannot be read gives an empty element.
page_files() {
    (
        cd "$tree_root" || exit 1
        { [ -n "$tree_list" ] && printf '%s\n' "$tree_list"; } |
        MD_OPENED=$tree_opened awk "$enc_fn"'
        # Each output line starts with a mark for the sed below: "T" for a tag
        # line, "|" for a text line, which gets the escapes.
        function emit(p, attrs,    f, line, n) {
            printf "T<script type=\"text/markdown\" %s data-path=\"%s\">\n", attrs, enc(p)
            f = "./" p
            n = 0
            while ((getline line < f) > 0) {
                if (n++ == 0 && substr(line, 1, 3) == "\357\273\277") line = substr(line, 4)
                if (substr(line, length(line)) == "\r") line = substr(line, 1, length(line) - 1)
                print "|" line
            }
            close(f)
            printf "T\nT</script>\n"
        }
        BEGIN {
            opened = ENVIRON["MD_OPENED"]
            emit(opened, "id=\"md\"")
        }
        substr($0, 1, 5) == "page " {
            p = substr($0, 6)
            if (p != opened) emit(p, "class=\"md-file\"")
        }' |
        # The escapes of the one-file page, with sed (linear in the line length).
        sed -e '/^T/{' -e 's/^T//' -e b -e '}' -e 's/^|//' \
            -e 's/\\/\\\\/g' -e 's|</|<\\/|g' -e 's|<!--|<\\!--|g'
    ) || return 1
    printf '<script type="text/plain" id="md-tree">\n'
    list_tree_text | sed -e 1d -e '/^cap /d'
    printf '</script>\n'
}

file=
out=
do_open=1
do_init=0
no_cache=0
flag_width=
flag_theme=
flag_browser=
flag_browser_set=0
flag_tree=
flag_palette=
list_tree=0
while [ $# -gt 0 ]; do
    case $1 in
        --version)
            printf 'md-view %s\n' "$version"
            exit 0 ;;
        --print-association)
            print_association
            exit 0 ;;
        --init-config)
            do_init=1 ;;
        --list-tree)
            list_tree=1 ;;
        --tree)
            [ $# -ge 2 ] || usage
            case $2 in
                on|off) flag_tree=$2 ;;
                *) usage ;;
            esac
            shift ;;
        --no-open)
            do_open=0 ;;
        --no-cache)
            no_cache=1 ;;
        --width)
            [ $# -ge 2 ] || usage
            case $2 in
                60|70|80|90) flag_width=$2 ;;
                *) usage ;;
            esac
            shift ;;
        --theme)
            [ $# -ge 2 ] || usage
            case $2 in
                light|dark|auto) flag_theme=$2 ;;
                *) usage ;;
            esac
            shift ;;
        --palette)
            [ $# -ge 2 ] || usage
            palette_ok "$2" || usage
            flag_palette=$2
            shift ;;
        --browser)
            [ $# -ge 2 ] || usage
            flag_browser=$2
            flag_browser_set=1
            shift ;;
        --out)
            [ $# -ge 2 ] || usage
            out=$2
            shift ;;
        --)
            # After "--" the one argument is the file name, even if it starts with "-".
            shift
            [ -z "$file" ] && [ $# -eq 1 ] || usage
            file=$1
            break ;;
        -*)
            # A file whose name starts with "-" still works when it exists.
            { [ -z "$file" ] && [ -f "$1" ]; } || usage
            file=$1 ;;
        *)
            [ -z "$file" ] || usage
            file=$1 ;;
    esac
    shift
done

[ "$do_init" = 1 ] && init_config

[ -n "$file" ] || usage

# Resolve the start values once: a flag, else the file, else the built-in default.
read_ini
forced=0
width=${flag_width:-${cfg_width:-70}}
theme=${flag_theme:-${cfg_theme:-auto}}
palette=${flag_palette:-${cfg_palette:-github}}
{ [ -n "$flag_width" ] || [ -n "$flag_theme" ] || [ -n "$flag_palette" ]; } && forced=1
if [ "$flag_browser_set" = 1 ]; then
    if browser_ok "$flag_browser"; then
        browser=$flag_browser
    else
        echo 'md-view: --browser is not auto, firefox, chrome, safari or a program path; using auto' >&2
        browser=auto
    fi
else
    if [ -z "$cfg_browser" ] && [ "$cfg_browser_bad" = 1 ]; then
        echo "md-view: browser= in $ini is not accepted; using auto" >&2
    fi
    browser=${cfg_browser:-auto}
fi
# Only accepted words reach the page.
case $width in 60|70|80|90) ;; *) width=70 ;; esac
case $theme in light|dark|auto) ;; *) theme=auto ;; esac
palette_ok "$palette" || palette=github
html_attrs="lang=\"en\" data-start-width=\"$width\" data-start-theme=\"$theme\" data-start-palette=\"$palette\""
if [ "$forced" = 1 ]; then
    html_attrs="$html_attrs data-forced=\"1\""
fi
if [ ! -f "$file" ] || [ ! -r "$file" ]; then
    echo "md-view: cannot read $file" >&2
    usage
fi

# The tree settings: a flag, else the file, else the default. Only accepted
# words and numbers are kept.
tree=${flag_tree:-${cfg_tree:-on}}
root_mode=${cfg_root:-dir}
tree_depth=${cfg_depth:-6}
tree_max=${cfg_max:-500}
tree_why=
if [ "$tree" = off ]; then
    if [ -n "$flag_tree" ]; then tree_why=flag; else tree_why=ini; fi
fi

# The real folder of the opened file and its name. The shell parameter forms
# keep a name that ends in a newline; "./" keeps cd from using CDPATH.
case $file in
    */*) file_dir=${file%/*}; [ -n "$file_dir" ] || file_dir=/ ;;
    *) file_dir=. ;;
esac
case $file_dir in
    /*) ;;
    *) file_dir=./$file_dir ;;
esac
file_name=${file##*/}
real_of "$file_dir" || { echo "md-view: cannot read $file" >&2; exit 2; }
real_dir=$rp
home_real=
case ${HOME:-} in
    /*) real_of "$HOME" 2>/dev/null && home_real=$rp ;;
esac

# The root: the real folder of the opened file, or with root=repo the first
# folder upward that has .git. The walk does not check / and stops after $HOME.
tree_root=$real_dir
if [ "$root_mode" = repo ] && find_repo_root "$real_dir"; then
    tree_root=$repo_root
fi
if [ -z "$tree_why" ]; then
    if [ "$tree_root" = / ]; then
        tree_why=slash
    elif [ -n "$home_real" ] && [ "$tree_root" = "$home_real" ]; then
        tree_why=home
    fi
fi
[ -z "$tree_why" ] && tree_mode=1 || tree_mode=0

# The tree path of the opened file: its real folder under the root, then its own
# name (a symlink keeps its name).
rel=${real_dir#"$tree_root"}
rel=${rel#/}
tree_opened=${rel:+$rel/}$file_name

tree_list=
tree_count=0
tree_capped=0
opened_in_list=0
# --list-tree scans and prints, then stops. A page run scans after its fast check.
if [ "$list_tree" = 1 ]; then
    if [ "$tree_mode" = 1 ]; then
        scan_tree || { echo 'md-view: cannot read the file tree' >&2; exit 2; }
    fi
    list_tree_text
    exit 0
fi

# The page path. --out names it. Else it is <base>-<crc>.html in the cache
# folder: <base> is the file name with each character outside A-Za-z0-9._- made
# "_" and cut to 40 characters, <crc> is the cksum of the real path of the file.
# A cache folder that cannot be made or used, or a page path that is a link or
# not a plain file, gives one stderr line and the old temporary page.
cached=0
if [ -n "$out" ]; then
    page=$out
else
    page=
    umask 077
    cache_home=${XDG_CACHE_HOME:-}
    case $cache_home in
        /*) ;;
        *) cache_home=${HOME:-}/.cache ;;
    esac
    cache_dir=${cache_home%/}/md-view
    if (umask 077; mkdir -p "$cache_dir") 2>/dev/null && [ -d "$cache_dir" ] && [ ! -L "$cache_dir" ] \
        && chmod 700 "$cache_dir" 2>/dev/null && [ -w "$cache_dir" ]; then
        # real_dir and file_name keep a newline at the end of a name, so a
        # folder "a<newline>" and a folder "a" get two page names.
        real=${real_dir%/}/$file_name
        crc=$(printf '%s' "$real" | cksum | sed 's/ .*//')
        base=$(printf '%s\n' "$file_name" | sed 's/[^A-Za-z0-9._-]/_/g' | cut -c1-40 | sed 1q)
        case $crc in
            ''|*[!0-9]*)
                echo 'md-view: cannot name the cache page; using a temporary page' >&2 ;;
            *)
                page=$cache_dir/$base-$crc.html
                if [ -L "$page" ] || { [ -e "$page" ] && [ ! -f "$page" ]; }; then
                    echo "md-view: $page is not a plain file; using a temporary page" >&2
                    page=
                else
                    cached=1
                fi ;;
        esac
    else
        echo "md-view: cannot use the cache folder $cache_dir; using a temporary page" >&2
    fi
    if [ -z "$page" ]; then
        tmp_dir=${TMPDIR:-/tmp}
        tmp_dir=${tmp_dir%/}
        page=$tmp_dir/md-view-$$.html
    fi
fi
if [ -d "$page" ] || [ ! -d "$(dirname -- "$page")" ]; then
    echo "md-view: cannot write the page $page (its folder must exist)" >&2
    exit 2
fi

marked_js=${MARKED_JS:-$self_dir/marked.min.js}
if [ ! -r "$marked_js" ]; then
    echo 'md-view: cannot find marked.min.js' >&2
    exit 3
fi
# The page inlines these vendored files and the page files (page.js, page.css).
# Each must be there before a page is written.
for f in github-markdown-light.css github-markdown-dark.css hljs-github.min.css \
         hljs-github-dark.min.css highlight.min.js page.js page.css; do
    if [ ! -f "$self_dir/$f" ] || [ ! -r "$self_dir/$f" ]; then
        echo "md-view: cannot find $f" >&2
        exit 3
    fi
done

# The page key and the state of config.ini go in the page head. The state is
# the size and the modification time that ls shows, or "none".
if [ "$tree_mode" = 1 ]; then tree_word=on; else tree_word=off; fi
key_line="<meta name=\"md-view-key\" content=\"w=$width;t=$theme;p=$palette;f=$forced;tr=$tree_word;r=$root_mode;d=$tree_depth;n=$tree_max;v=$version\">"
ini_state=none
if [ -f "$ini" ]; then
    ini_state=$(ls -lnLd -- "$ini" 2>/dev/null \
        | sed -n 's/^[^ ]*  *[^ ]*  *[^ ]*  *[^ ]*  *\([0-9][0-9]*\)  *\([^ ]*\)  *\([^ ]*\)  *\([^ ]*\) .*$/\1 \2 \3 \4/p' \
        | sed -e 's/[^A-Za-z0-9 :.]/_/g' -e 1q)
    [ -n "$ini_state" ] || ini_state=unknown
fi
ini_line="<!-- md-view-ini: $ini_state -->"

# The folder of the Markdown file as a file:// URL for <base href>. In tree mode it
# is the root. base_line is the head line with it; page_fresh compares the line.
if [ "$tree_mode" = 1 ]; then
    dir=$tree_root
else
    dir=$(cd "$(dirname -- "$file")" && pwd) || exit 2
fi
case $dir in
    */) ;;
    *) dir=$dir/ ;;
esac
# A newline in the path becomes %0A, so the base stays on one line.
base_url=file://$(printf '%s' "$dir" | sed -e 's/%/%25/g' -e 's/ /%20/g' -e 's/#/%23/g' \
    -e 's/?/%3F/g' -e 's/"/%22/g' -e "s/'/%27/g" -e 's/</%3C/g' -e 's/>/%3E/g' -e 's/&/%26/g' \
    | awk 'NR > 1 { printf "%%0A" } { printf "%s", $0 }')
base_line=$(printf '<base href="%s">' "$base_url")

# The page of this run as an absolute path, for the -newer walk.
case $page in
    /*) abs_page=$page ;;
    *) abs_page=$(pwd)/$page ;;
esac

# head_has LINE: true if LINE is one of the lines of the head of the page, which
# ends at the first </head> line.
head_has() {
    sed -n '1,/^<\/head>$/p' "$page" | grep -qxF -- "$1"
}

# page_fresh: true if the cache page can be reused with no scan. The page is a
# plain file, and no input is newer than it. The head has the key and the ini
# state of this run. In tree mode the head also has the base line of this root,
# so a root that moved (a .git removed with root=repo) builds the page again.
# The tree files are checked by tree_newer, not here.
page_fresh() {
    [ -f "$page" ] && [ ! -L "$page" ] || return 1
    abs_marked=$marked_js
    case $abs_marked in
        /*) ;;
        *) abs_marked=$(pwd)/$abs_marked ;;
    esac
    set -- "$real" "$self_dir/$(basename -- "$0")" "$abs_marked"
    for f in github-markdown-light.css github-markdown-dark.css hljs-github.min.css \
             hljs-github-dark.min.css highlight.min.js page.js page.css; do
        set -- "$@" "$self_dir/$f"
    done
    [ -f "$ini" ] && set -- "$@" "$ini"
    newer=$(find -H "$@" -prune -newer "$page" -print 2>/dev/null) || return 1
    [ -z "$newer" ] || return 1
    head_has "$key_line" || return 1
    head_has "$ini_line" || return 1
    if [ "$tree_mode" = 1 ]; then
        head_has "$base_line" || return 1
    fi
}

# tree_newer: prints the tree folders and the tree files that are newer than the
# page, one ./<path> line each, the root as ".". It is one find walk, with the
# skip rules of scan_find. A folder line is not a tree file; the caller tests it
# with [ -f ]. The status is find's, so a failed walk fails and the page is built.
tree_newer() {
    scan_find -newer "$abs_page" -print -o -type d -newer "$abs_page"
}

# reuse_page: the page is good. It restores the umask of the caller, opens the
# page when do_open is 1, and exits 0.
reuse_page() {
    umask "$old_umask"
    if [ "$do_open" = 1 ]; then
        open_page "$page"
    fi
    exit 0
}

# The fast check. In one-file mode page_fresh is the whole check. In tree mode
# tree_newer lists what changed since the page. Nothing listed: reuse. Only
# folders listed: head_ok is 1, and the scan below decides. A tree file listed, or
# a failed walk: head_ok stays 0, and the page is built.
head_ok=0
if [ "$cached" = 1 ] && [ "$no_cache" = 0 ] && page_fresh; then
    if [ "$tree_mode" != 1 ]; then
        reuse_page
    fi
    if newer=$(tree_newer); then
        [ -n "$newer" ] || reuse_page
        # The lines go through a pipe into read, so a name with blanks or shell
        # characters stays one line.
        newer_file=$(printf '%s\n' "$newer" | while IFS= read -r line; do
            if [ -f "$tree_root/${line#./}" ]; then printf '%s\n' "$line"; break; fi
        done)
        if [ -z "$newer_file" ]; then
            head_ok=1
        fi
    fi
fi

if [ "$tree_mode" = 1 ]; then
    # In tree mode the head has the tree state: the cksum of the --list-tree output
    # and the number of tree files up to the cap. The html element gets the tree
    # attributes; each value is an encoded path, a number or an accepted word.
    scan_tree || { echo 'md-view: cannot read the file tree' >&2; exit 2; }
    tree_sum=$(list_tree_text | cksum | sed 's/ .*//')
    case $tree_sum$tree_count in
        ''|*[!0-9]*) echo 'md-view: cannot read the file tree' >&2; exit 2 ;;
    esac
    [ "$tree_capped" = 1 ] || tree_capped=0
    tree_line="<!-- md-view-tree: $tree_sum $tree_count -->"
    root_enc=$(enc_path "${tree_root##*/}")
    html_attrs="$html_attrs data-tree=\"on\" data-root=\"$root_enc\" data-files=\"$tree_count\" data-cap=\"$tree_capped\""
    if [ "$head_ok" = 1 ] && head_has "$tree_line"; then
        reuse_page
    fi
else
    tree_line=
    html_attrs="$html_attrs data-tree=\"off\" data-tree-why=\"$tree_why\""
fi

# The cache page and the temporary page are written to a temporary file in their
# folder, then moved over the page, so a reader never sees a half page. The file
# goes on error or a signal. noclobber: the shell does not write through a file
# or link made at that path. --out keeps the old direct write to its path.
tmpf=
dest=$page
if [ -z "$out" ]; then
    tmpf=$page.tmp.$$
    trap 'rm -f "$tmpf"' EXIT
    trap 'exit 1' INT TERM HUP
    rm -f "$tmpf"
    set -C
    dest=$tmpf
fi

title=$(basename -- "$file" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e 's/"/\&quot;/g')
bom=$(printf '\357\273\277')

{
    printf '<!doctype html>\n<html %s>\n' "$html_attrs"
    cat <<'HTML'
<head>
<meta charset="utf-8">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'unsafe-inline'; img-src data: file:">
<meta name="viewport" content="width=device-width, initial-scale=1">
HTML
    printf '%s\n%s\n%s\n' "$key_line" "$ini_line" "<meta name=\"md-view-version\" content=\"$version\">"
    [ -n "$tree_line" ] && printf '%s\n' "$tree_line"
    printf '%s\n' "$base_line"
    printf '<title>%s</title>\n' "$title"
    # The vendored files go in as they are. Each pair is switched by its media
    # attribute; the page script sets it, and the values here are the start.
    printf '<style id="gh-light" media="all">\n'
    cat "$self_dir/github-markdown-light.css"
    printf '\n</style>\n<style id="gh-dark" media="not all">\n'
    cat "$self_dir/github-markdown-dark.css"
    printf '\n</style>\n<style id="hl-light" media="all">\n'
    cat "$self_dir/hljs-github.min.css"
    printf '\n</style>\n<style id="hl-dark" media="not all">\n'
    cat "$self_dir/hljs-github-dark.min.css"
    printf '\n</style>\n'
    # The page style is in page.css. The palette layer is the lines that start with
    # html[data-palette], before the flash rule at the end of the file. They set
    # colors only, from the --p- variables, and only when html has the attribute,
    # so the github look does not change. Each one takes the selector of the vendored
    # rule that sets the same property and adds the prefix, so it is the more
    # specific one. The flash rule, .markdown-body .md-line-target, is not in the
    # layer. It has !important, so it wins over the table rows and the palette.
    # The tree rules of the layer are in the tree block below.
    printf '<style id="page">\n'
    cat "$self_dir/page.css"
    # The panel CSS and markup are in tree mode only. In one-file mode the page
    # stays the one-file page.
    if [ "$tree_mode" = 1 ]; then
        cat <<'CSS'
html[data-panel="open"] body { padding-left: calc(var(--md-panel-w, 300px) + 16px) }
#md-tree-panel { position: fixed; top: 0; left: 0; bottom: 0; z-index: 10; box-sizing: border-box; width: var(--md-panel-w, 300px); padding: 8px; overflow: auto; border-right: 1px solid GrayText; background: Canvas; color: CanvasText; font: 13px/1.4 sans-serif }
html[data-panel="closed"] #md-tree-panel { display: none }
#md-tree-toggle { position: fixed; top: 8px; left: calc(var(--md-panel-w, 300px) + 8px); z-index: 20; box-sizing: border-box; width: 28px; height: 28px; margin: 0; padding: 0; border: 1px solid GrayText; border-radius: 6px; background: Canvas; color: CanvasText; font: 14px/1 sans-serif; cursor: pointer }
html[data-panel="closed"] #md-tree-toggle { left: 8px }
#md-tree-resize { position: fixed; top: 0; left: calc(var(--md-panel-w, 300px) - 3px); bottom: 0; z-index: 15; width: 6px; cursor: col-resize; touch-action: none }
html[data-panel="closed"] #md-tree-resize { display: none }
#md-tree-panel .md-root { position: sticky; top: 0; margin: 0 0 6px; padding: 2px 0; font-weight: 600; overflow-wrap: anywhere; background: inherit }
#md-tree-panel details { margin: 0 }
#md-tree-panel details > div { margin-left: 12px; padding-left: 8px; border-left: 1px solid GrayText }
#md-tree-panel summary { cursor: pointer; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; list-style: none }
#md-tree-panel summary::-webkit-details-marker { display: none }
#md-tree-panel summary::before { content: '›'; display: inline-block; width: 1em; transition: transform .1s linear }
#md-tree-panel details[open] > summary::before { transform: rotate(90deg) }
#md-tree-panel a { display: block; padding-left: 1em; color: color-mix(in srgb, CanvasText 70%, Canvas); text-decoration: none; white-space: nowrap; overflow: hidden; text-overflow: ellipsis }
#md-tree-panel a:hover, #md-tree-panel a:focus { text-decoration: underline }
#md-tree-panel a[aria-current="page"] { font-weight: 600; background: Highlight; color: HighlightText }
#md-tree-panel a.md-off { opacity: .5 }
#md-tree-panel .md-cap { margin-top: 6px; font-style: italic; opacity: .7 }
html[data-palette] #md-tree-panel { background-color: var(--p-bg-dark); color: var(--p-fg-dark); border-color: var(--p-border) }
html[data-palette] #md-tree-panel a { color: var(--p-fg) }
html[data-palette] #md-tree-panel .md-root { color: var(--p-fg) }
html[data-palette] #md-tree-panel details > div { border-color: var(--p-border) }
html[data-palette] #md-tree-panel a:hover, html[data-palette] #md-tree-panel a:focus { color: var(--p-blue) }
html[data-palette] #md-tree-panel a[aria-current="page"] { background-color: var(--p-bg-visual); color: var(--p-fg) }
html[data-palette] #md-tree-toggle { background-color: var(--p-bg-dark); color: var(--p-fg-dark); border-color: var(--p-border) }
@media (max-width: 699px) {
  html[data-panel] body { padding-left: 16px }
  #md-tree-panel, #md-tree-toggle { display: none }
  #md-tree-resize { display: none }
}
@media print { #md-gear, #md-pop, #md-tree-panel, #md-tree-toggle, .md-dbar { display: none !important } }
@media print { #md-tree-resize { display: none !important } }
CSS
    else
        cat <<'CSS'
@media print { #md-gear, #md-pop, .md-dbar { display: none !important } }
CSS
    fi
    cat <<'HTML'
</style>
</head>
<body class="markdown-body">
<button id="md-gear" type="button" aria-label="Page settings" aria-expanded="false" aria-controls="md-pop">&#9881;</button>
<div id="md-pop" hidden></div>
HTML
    if [ "$tree_mode" = 1 ]; then
        printf '<button id="md-tree-toggle" type="button" aria-label="Files" aria-controls="md-tree-panel" aria-expanded="true">&#9776;</button>\n'
        printf '<nav id="md-tree-panel" aria-label="Files"></nav>\n'
        printf '<div id="md-tree-resize" role="separator" aria-orientation="vertical" aria-label="Resize the file tree" tabindex="0"></div>\n'
    fi
    printf '<main id="content" class="markdown-body"></main>\n'
    # The text cannot end its script element or open a comment there. Backslashes
    # are doubled first, then "</" becomes "<\/" and "<!--" becomes "<\!--"; the
    # page undoes the steps in reverse order. A BOM and CRs go too.
    if [ "$tree_mode" = 1 ]; then
        page_files || exit 1
    else
        printf '<script type="text/markdown" id="md">\n'
        sed -e "1s/^$bom//" -e "s/$cr\$//" -e 's/\\/\\\\/g' -e 's|</|<\\/|g' -e 's|<!--|<\\!--|g' < "$file"
        printf '\n</script>\n'
    fi
    printf '<script>\n'
    cat "$marked_js"
    printf '\n</script>\n<script>\n'
    cat "$self_dir/highlight.min.js"
    printf '\n</script>\n<script>\n'
    # The page script is in page.js. It goes in as it is.
    cat "$self_dir/page.js"
    printf '</script>\n</body>\n</html>\n'
} > "$dest" || { echo "md-view: cannot write $page" >&2; exit 1; }
if [ -n "$tmpf" ]; then
    set +C
    mv -f "$tmpf" "$page" || { echo "md-view: cannot write $page" >&2; exit 1; }
    trap - EXIT
fi
umask "$old_umask"

if [ "$do_open" = 1 ]; then
    open_page "$page"
fi
exit 0
